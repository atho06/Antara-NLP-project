<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Antara.Screen.Scroll"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_analytics_back"
                style="@style/Antara.IconButton"
                android:contentDescription="@string/cd_back"
                android:src="@drawable/ic_arrow_back" />

        </LinearLayout>

        <!-- Header -->
        <TextView
            style="@style/Antara.Text.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_section"
            android:text="What you've noticed lately" />

        <TextView
            style="@style/Antara.Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:text="A quiet look at the moods and moments you've shared." />

        <!-- Timeframe Filter Chips -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_section"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_filter_all"
                style="@style/Antara.Chip"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_s"
                android:layout_weight="1"
                android:background="@drawable/bg_option_selected"
                android:text="All time"
                android:textColor="@color/primary_dark" />

            <TextView
                android:id="@+id/btn_filter_week"
                style="@style/Antara.Chip"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_s"
                android:layout_weight="1"
                android:text="Past 7 days"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/btn_filter_today"
                style="@style/Antara.Chip"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Today"
                android:textColor="@color/text_secondary" />

        </LinearLayout>

        <!-- Gentle Reflection Summary Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_section"
            android:orientation="horizontal">

            <LinearLayout
                style="@style/Antara.Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1">

                <TextView
                    style="@style/Antara.Text.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Time reflecting" />

                <TextView
                    android:id="@+id/tv_stat_minutes"
                    style="@style/Antara.Text.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="0 min"
                    android:textColor="@color/primary" />

            </LinearLayout>

            <LinearLayout
                style="@style/Antara.Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1">

                <TextView
                    style="@style/Antara.Text.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Days showing up" />

                <TextView
                    android:id="@+id/tv_stat_streak"
                    style="@style/Antara.Text.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="0 days"
                    android:textColor="@color/primary" />

            </LinearLayout>

        </LinearLayout>

        <!-- Emotional Tones Card -->
        <LinearLayout
            style="@style/Antara.Card"
            android:layout_marginTop="@dimen/space_section">

            <TextView
                style="@style/Antara.Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tones noticed" />

            <TextView
                style="@style/Antara.Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="How your reflections felt" />

            <TextView
                style="@style/Antara.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="A gentle mix of the feelings recognized across your sessions." />

            <TextView
                android:id="@+id/tv_analytics_empty_note"
                style="@style/Antara.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_group"
                android:text="Your mix of tones will appear here once you save a reflection in this timeframe."
                android:visibility="gone" />

            <!-- Calm -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Antara.Text.FieldLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Calm and grounded" />

                    <TextView
                        android:id="@+id/tv_pct_calm"
                        style="@style/Antara.Text.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito_bold"
                        android:text="0%" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/pb_calm"
                    style="@style/Antara.Progress"
                    android:layout_height="8dp"
                    android:layout_marginTop="@dimen/space_s"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="@color/primary" />

            </LinearLayout>

            <!-- Joy -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_group"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Antara.Text.FieldLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Joy and lightness" />

                    <TextView
                        android:id="@+id/tv_pct_joy"
                        style="@style/Antara.Text.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito_bold"
                        android:text="0%" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/pb_joy"
                    style="@style/Antara.Progress"
                    android:layout_height="8dp"
                    android:layout_marginTop="@dimen/space_s"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="@color/primary_light" />

            </LinearLayout>

            <!-- Tender / Sadness -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_group"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Antara.Text.FieldLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Tender or low" />

                    <TextView
                        android:id="@+id/tv_pct_sad"
                        style="@style/Antara.Text.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito_bold"
                        android:text="0%" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/pb_sad"
                    style="@style/Antara.Progress"
                    android:layout_height="8dp"
                    android:layout_marginTop="@dimen/space_s"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="@color/label" />

            </LinearLayout>

            <!-- Stress -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_group"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Antara.Text.FieldLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Stress and overwhelm" />

                    <TextView
                        android:id="@+id/tv_pct_stress"
                        style="@style/Antara.Text.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito_bold"
                        android:text="0%" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/pb_stress"
                    style="@style/Antara.Progress"
                    android:layout_height="8dp"
                    android:layout_marginTop="@dimen/space_s"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="@color/text_secondary" />

            </LinearLayout>

        </LinearLayout>

        <!-- Cycle & Rhythm Panel -->
        <LinearLayout
            android:id="@+id/card_cycle_insight"
            style="@style/Antara.Panel.Sage"
            android:layout_marginTop="@dimen/space_section">

            <TextView
                style="@style/Antara.Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cycle and rhythm" />

            <TextView
                style="@style/Antara.Text.Subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="Moving with your cycle" />

            <TextView
                android:id="@+id/tv_cycle_insight_text"
                style="@style/Antara.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="If you'd like, you can optionally note your cycle phase in Settings to tailor your reflection context." />

        </LinearLayout>

        <!-- Footer reassurance -->
        <TextView
            style="@style/Antara.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:gravity="center"
            android:text="Your reflections are stored on this device." />

    </LinearLayout>

</ScrollView>
