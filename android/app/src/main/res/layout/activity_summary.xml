<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Antara.Screen.Scroll"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <View
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginTop="@dimen/space_m"
            android:background="@drawable/motif_breath"
            android:importantForAccessibility="no" />

        <TextView
            style="@style/Antara.Text.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_section"
            android:gravity="center"
            android:text="Thank you for showing up for yourself" />

        <TextView
            style="@style/Antara.Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:gravity="center"
            android:text="Take a breath. There's no rush here." />

        <!-- Summary Card -->
        <LinearLayout
            style="@style/Antara.Card"
            android:layout_marginTop="@dimen/space_section">

            <TextView
                style="@style/Antara.Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Session reflection" />

            <TextView
                android:id="@+id/tv_sum_emotion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_group"
                android:background="@drawable/bg_emotion_bubble"
                android:fontFamily="@font/nunito_semibold"
                android:text="Calm and grounded"
                android:textColor="@color/primary_dark"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Antara.Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Time taken" />

                    <TextView
                        android:id="@+id/tv_sum_duration"
                        style="@style/Antara.Text.Subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:text="5 min" />

                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="@dimen/space_group"
                    android:layout_marginEnd="@dimen/space_group"
                    android:background="@color/border" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Antara.Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Reflections" />

                    <TextView
                        android:id="@+id/tv_sum_answers"
                        style="@style/Antara.Text.Subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:text="3 reflections" />

                </LinearLayout>

            </LinearLayout>

            <View
                style="@style/Antara.Divider"
                android:layout_marginTop="@dimen/space_m"
                android:layout_marginBottom="@dimen/space_m" />

            <TextView
                android:id="@+id/tv_sum_text"
                style="@style/Antara.Text.BodyStrong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Thank you for taking this quiet moment to listen inward." />

        </LinearLayout>

        <!-- Gentle closing panel -->
        <LinearLayout
            style="@style/Antara.Panel.Sage"
            android:layout_marginTop="@dimen/space_section">

            <TextView
                style="@style/Antara.Text.BodyStrong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Be gentle with yourself today. Even a few quiet minutes of reflection matter." />

        </LinearLayout>

        <!-- Primary action -->
        <Button
            android:id="@+id/btn_sum_home"
            style="@style/Antara.Button.Primary"
            android:layout_marginTop="@dimen/space_section"
            android:text="Back to home" />

        <TextView
            style="@style/Antara.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_group"
            android:gravity="center"
            android:text="This reflection is saved on this device." />

    </LinearLayout>

</ScrollView>
