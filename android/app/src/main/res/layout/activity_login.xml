<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Antara.Screen.Scroll"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <View
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="@dimen/space_m"
            android:background="@drawable/motif_breath"
            android:importantForAccessibility="no" />

        <TextView
            style="@style/Antara.Text.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:text="Welcome back" />

        <TextView
            style="@style/Antara.Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:text="Take a breath. Sign in to your space on this device." />

        <LinearLayout
            style="@style/Antara.Card"
            android:layout_marginTop="@dimen/space_section">

            <TextView
                style="@style/Antara.Text.FieldLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:labelFor="@id/et_login_email"
                android:text="Email" />

            <EditText
                android:id="@+id/et_login_email"
                style="@style/Antara.Input"
                android:layout_marginTop="@dimen/space_s"
                android:autofillHints="emailAddress"
                android:hint="you@example.com"
                android:inputType="textEmailAddress" />

            <TextView
                style="@style/Antara.Text.FieldLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_group"
                android:labelFor="@id/et_login_password"
                android:text="Password" />

            <EditText
                android:id="@+id/et_login_password"
                style="@style/Antara.Input"
                android:layout_marginTop="@dimen/space_s"
                android:autofillHints="password"
                android:hint="Enter your password"
                android:inputType="textPassword" />

            <Button
                android:id="@+id/btn_login_submit"
                style="@style/Antara.Button.Primary"
                android:layout_marginTop="@dimen/space_section"
                android:text="Sign in" />

        </LinearLayout>

        <Button
            android:id="@+id/tv_login_register"
            style="@style/Antara.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_m"
            android:text="New here? Create an account" />

        <TextView
            style="@style/Antara.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_section"
            android:gravity="center"
            android:text="Your account is stored on this device." />

    </LinearLayout>

</ScrollView>
