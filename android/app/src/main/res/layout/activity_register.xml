<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Antara.Screen.Scroll"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <View
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/motif_breath"
            android:importantForAccessibility="no" />

        <TextView
            style="@style/Antara.Text.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:text="Create your space" />

        <TextView
            style="@style/Antara.Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:text="Set up a profile to begin. Your account is stored on this device." />

        <LinearLayout
            style="@style/Antara.Card"
            android:layout_marginTop="@dimen/space_section">

            <TextView
                style="@style/Antara.Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your details" />

            <TextView
                style="@style/Antara.Text.FieldLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_group"
                android:labelFor="@id/et_reg_name"
                android:text="Full name" />

            <EditText
                android:id="@+id/et_reg_name"
                style="@style/Antara.Input"
                android:layout_marginTop="@dimen/space_s"
                android:autofillHints="name"
                android:hint="How should Antara greet you?"
                android:inputType="textPersonName|textCapWords" />

            <TextView
                style="@style/Antara.Text.FieldLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_group"
                android:labelFor="@id/et_reg_email"
                android:text="Email" />

            <EditText
                android:id="@+id/et_reg_email"
                style="@style/Antara.Input"
                android:layout_marginTop="@dimen/space_s"
                android:autofillHints="emailAddress"
                android:hint="you@example.com"
                android:inputType="textEmailAddress" />

            <TextView
                style="@style/Antara.Text.FieldLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_group"
                android:labelFor="@id/et_reg_password"
                android:text="Password" />

            <EditText
                android:id="@+id/et_reg_password"
                style="@style/Antara.Input"
                android:layout_marginTop="@dimen/space_s"
                android:autofillHints="newPassword"
                android:hint="At least 6 characters"
                android:inputType="textPassword" />

            <TextView
                style="@style/Antara.Text.FieldLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_group"
                android:labelFor="@id/et_reg_phone"
                android:text="Phone number (optional)" />

            <EditText
                android:id="@+id/et_reg_phone"
                style="@style/Antara.Input"
                android:layout_marginTop="@dimen/space_s"
                android:autofillHints="phone"
                android:hint="Optional"
                android:inputType="phone" />

        </LinearLayout>

        <LinearLayout
            style="@style/Antara.Card"
            android:layout_marginTop="@dimen/space_section">

            <TextView
                style="@style/Antara.Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trusted contact (optional)" />

            <TextView
                style="@style/Antara.Text.Small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="Someone you trust to keep handy in the app if you want to reach out. You can add or change this later in Settings." />

            <TextView
                style="@style/Antara.Text.FieldLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_group"
                android:labelFor="@id/et_reg_contact_name"
                android:text="Contact name" />

            <EditText
                android:id="@+id/et_reg_contact_name"
                style="@style/Antara.Input"
                android:layout_marginTop="@dimen/space_s"
                android:hint="Name"
                android:inputType="textPersonName|textCapWords" />

            <TextView
                style="@style/Antara.Text.FieldLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_group"
                android:labelFor="@id/et_reg_contact_phone"
                android:text="Contact phone" />

            <EditText
                android:id="@+id/et_reg_contact_phone"
                style="@style/Antara.Input"
                android:layout_marginTop="@dimen/space_s"
                android:hint="Phone number"
                android:inputType="phone" />

            <TextView
                style="@style/Antara.Text.FieldLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_group"
                android:labelFor="@id/et_reg_contact_email"
                android:text="Contact email" />

            <EditText
                android:id="@+id/et_reg_contact_email"
                style="@style/Antara.Input"
                android:layout_marginTop="@dimen/space_s"
                android:hint="Email address"
                android:inputType="textEmailAddress" />

        </LinearLayout>

        <Button
            android:id="@+id/btn_reg_submit"
            style="@style/Antara.Button.Primary"
            android:layout_marginTop="@dimen/space_section"
            android:text="Create account" />

        <Button
            android:id="@+id/tv_reg_login"
            style="@style/Antara.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_m"
            android:text="Already have an account? Sign in" />

        <TextView
            style="@style/Antara.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_group"
            android:gravity="center"
            android:text="Your account and reflections stay in a local database on this device." />

    </LinearLayout>

</ScrollView>
