<?xml version="1.0" encoding="utf-8"?>
<!-- Arrival header at the top of the Reflection conversation -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_margin"
    android:paddingTop="@dimen/space_m"
    android:paddingEnd="@dimen/screen_margin"
    android:paddingBottom="@dimen/space_group">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="@dimen/space_s"
        android:paddingBottom="@dimen/space_section">

        <View
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:background="@drawable/motif_breath" />

        <TextView
            style="@style/Antara.Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:text="Arrive as you are." />

        <TextView
            style="@style/Antara.Text.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="Take a breath. There's no rush here." />
    </LinearLayout>

    <TextView
        style="@style/Antara.Text.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Antara · Here to listen" />

</LinearLayout>
