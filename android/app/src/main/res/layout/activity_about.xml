<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Antara.Screen.Scroll"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_about_back"
                style="@style/Antara.IconButton"
                android:contentDescription="@string/cd_back"
                android:src="@drawable/ic_arrow_back" />

            <TextView
                style="@style/Antara.Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_group"
                android:text="About" />

        </LinearLayout>

        <!-- Brand intro -->
        <View
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="@dimen/space_section"
            android:background="@drawable/motif_breath"
            android:importantForAccessibility="no" />

        <TextView
            style="@style/Antara.Text.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:text="Antara" />

        <TextView
            style="@style/Antara.Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:text="A little space to be yourself. Antara comes from the Sanskrit word for the inner space within." />

        <!-- What Antara is -->
        <LinearLayout
            style="@style/Antara.Card"
            android:layout_marginTop="@dimen/space_section">

            <TextView
                style="@style/Antara.Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="What Antara is" />

            <TextView
                style="@style/Antara.Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="An on-device reflection companion" />

            <TextView
                style="@style/Antara.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_group"
                android:text="Antara offers short, unhurried check-ins where you can choose from suggested responses or write in your own words. It uses on-device natural language processing (NLP) to respond to what you share and reflect general emotional tone." />

            <TextView
                style="@style/Antara.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_group"
                android:text="Your account, reflections, and journal history are stored in a local database on this device." />

        </LinearLayout>

        <!-- What Antara is not -->
        <LinearLayout
            style="@style/Antara.Panel.Warm"
            android:layout_marginTop="@dimen/space_section">

            <TextView
                style="@style/Antara.Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Important to know" />

            <TextView
                style="@style/Antara.Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="What Antara is not" />

            <TextView
                style="@style/Antara.Text.BodyStrong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_group"
                android:text="Antara is not therapy, medical advice, or a substitute for professional care. It is not an emergency service and cannot respond to crises in real time." />

        </LinearLayout>

        <!-- External helplines -->
        <LinearLayout
            style="@style/Antara.Card"
            android:layout_marginTop="@dimen/space_section">

            <TextView
                style="@style/Antara.Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="External helplines" />

            <TextView
                style="@style/Antara.Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="If you need someone to talk to" />

            <TextView
                style="@style/Antara.Text.Small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="These helplines are external services operated independently of Antara." />

            <View
                style="@style/Antara.Divider"
                android:layout_marginTop="@dimen/space_m"
                android:layout_marginBottom="@dimen/space_m" />

            <TextView
                style="@style/Antara.Text.FieldLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tele-MANAS" />

            <TextView
                style="@style/Antara.Text.Small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="14416" />

            <TextView
                style="@style/Antara.Text.FieldLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_group"
                android:text="KIRAN Mental Health Helpline" />

            <TextView
                style="@style/Antara.Text.Small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="1800-599-0019" />

            <TextView
                style="@style/Antara.Text.FieldLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_group"
                android:text="Vandrevala Foundation" />

            <TextView
                style="@style/Antara.Text.Small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="+91 9999 666 555" />

        </LinearLayout>

        <!-- Gentle note -->
        <LinearLayout
            style="@style/Antara.Panel.Sage"
            android:layout_marginTop="@dimen/space_section">

            <TextView
                style="@style/Antara.Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="A gentle reminder" />

            <TextView
                style="@style/Antara.Text.BodyStrong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="You don't have to have everything figured out today. Taking a few quiet minutes to check in with yourself is enough." />

        </LinearLayout>

        <!-- Version footer (tap 5 times for Evaluator Dashboard) -->
        <TextView
            android:id="@+id/tv_about_version"
            style="@style/Antara.Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_xl"
            android:gravity="center"
            android:padding="@dimen/space_s"
            android:text="Antara • Version 1.0.0\nOn-device reflection companion" />

    </LinearLayout>

</ScrollView>
