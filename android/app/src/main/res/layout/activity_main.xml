<?xml version="1.0" encoding="utf-8"?>
<!--
    Home. Reference screen for the Antara design system.
    Warm off-white background, sage reminder panel, white reflection card,
    quiet circle motifs, 24dp between sections, 12dp within groups.
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Bottom navigation: text labels with a small dot for the current page -->
    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true"
        android:background="@color/surface"
        android:orientation="vertical">

        <View style="@style/Antara.Divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/nav_home"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:orientation="vertical">

                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/bg_nav_dot" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/nunito_bold"
                    android:text="Home"
                    android:textColor="@color/primary"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_analytics"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:orientation="vertical">

                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/bg_nav_dot"
                    android:visibility="invisible" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/nunito_semibold"
                    android:text="Insights"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_history"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:orientation="vertical">

                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/bg_nav_dot"
                    android:visibility="invisible" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/nunito_semibold"
                    android:text="Journal"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_settings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:orientation="vertical">

                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/bg_nav_dot"
                    android:visibility="invisible" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/nunito_semibold"
                    android:text="Settings"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        style="@style/Antara.Screen.Scroll"
        android:layout_above="@id/bottom_nav">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_greeting_time"
                        style="@style/Antara.Text.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Your daily exhale" />

                    <TextView
                        android:id="@+id/tv_user_name"
                        style="@style/Antara.Text.Display"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Hi there."
                        tools:text="Hi, Arjun." />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_sos_header"
                    style="@style/Antara.Button.Pill.Support"
                    android:layout_height="36dp"
                    android:minHeight="36dp"
                    android:contentDescription="Get support now"
                    android:text="SOS" />
            </LinearLayout>

            <!-- A gentle reminder -->
            <LinearLayout
                style="@style/Antara.Panel.Sage"
                android:layout_marginTop="@dimen/space_section">

                <TextView
                    style="@style/Antara.Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="A gentle reminder" />

                <TextView
                    style="@style/Antara.Text.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_group"
                    android:text="You don't have to figure it all out today." />

                <TextView
                    style="@style/Antara.Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:text="A little space for yourself is enough." />
            </LinearLayout>

            <!-- One day at a time -->
            <LinearLayout
                android:id="@+id/card_streak_dashboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_section"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_streak_title"
                        style="@style/Antara.Text.Subtitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="One day at a time" />

                    <TextView
                        android:id="@+id/tv_streak_level"
                        style="@style/Antara.Text.Accent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sprout level" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_group"
                    android:orientation="horizontal">

                    <TextView android:id="@+id/dot_mon" style="@style/Antara.DayCircle" android:text="M" />
                    <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                    <TextView android:id="@+id/dot_tue" style="@style/Antara.DayCircle" android:text="T" />
                    <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                    <TextView android:id="@+id/dot_wed" style="@style/Antara.DayCircle" android:text="W" />
                    <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                    <TextView android:id="@+id/dot_thu" style="@style/Antara.DayCircle" android:text="T" />
                    <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                    <TextView android:id="@+id/dot_fri" style="@style/Antara.DayCircle" android:text="F" />
                    <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                    <TextView android:id="@+id/dot_sat" style="@style/Antara.DayCircle" android:text="S" />
                    <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                    <TextView android:id="@+id/dot_sun" style="@style/Antara.DayCircle" android:text="S" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_streak_sub"
                    style="@style/Antara.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_group"
                    android:text="Your first reflection is a fresh beginning." />
            </LinearLayout>

            <!-- Resume an unfinished reflection (shown only when a draft exists) -->
            <LinearLayout
                android:id="@+id/card_resume_session"
                style="@style/Antara.Panel.Sage"
                android:layout_marginTop="@dimen/space_section"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Antara.Text.Label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Waiting for you" />

                    <TextView
                        android:id="@+id/tv_resume_time_ago"
                        style="@style/Antara.Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Paused earlier" />
                </LinearLayout>

                <TextView
                    style="@style/Antara.Text.Subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_group"
                    android:text="Pick up where you left off" />

                <TextView
                    android:id="@+id/tv_resume_details"
                    style="@style/Antara.Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="You stepped away during your reflection. You can continue whenever you like." />

                <Button
                    android:id="@+id/btn_resume_session"
                    style="@style/Antara.Button.Primary"
                    android:layout_marginTop="@dimen/space_m"
                    android:text="Continue reflection" />
            </LinearLayout>

            <!-- A moment just for you: primary action -->
            <LinearLayout
                style="@style/Antara.Card"
                android:layout_marginTop="@dimen/space_section">

                <View
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/motif_ring" />

                <TextView
                    style="@style/Antara.Text.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:text="A moment just for you" />

                <TextView
                    style="@style/Antara.Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="Check in, untangle your thoughts, and take a softer next step." />

                <TextView
                    style="@style/Antara.Text.FieldLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:labelFor="@id/spn_duration"
                    android:text="Session time" />

                <Spinner
                    android:id="@+id/spn_duration"
                    style="@style/Antara.Spinner"
                    android:layout_marginTop="@dimen/space_s" />

                <TextView
                    style="@style/Antara.Text.FieldLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_group"
                    android:labelFor="@id/spn_category"
                    android:text="Focus topic" />

                <Spinner
                    android:id="@+id/spn_category"
                    style="@style/Antara.Spinner"
                    android:layout_marginTop="@dimen/space_s" />

                <Button
                    android:id="@+id/btn_start_session"
                    style="@style/Antara.Button.Primary"
                    android:layout_marginTop="@dimen/space_section"
                    android:text="Begin my reflection" />

                <TextView
                    style="@style/Antara.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_group"
                    android:gravity="center"
                    android:text="No pressure. No right answers. Just you." />
            </LinearLayout>

            <!-- Slow down and tune in -->
            <LinearLayout
                android:id="@+id/card_cycle_support"
                style="@style/Antara.Panel.Warm"
                android:layout_marginTop="@dimen/space_section">

                <TextView
                    style="@style/Antara.Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Slow down and tune in" />

                <TextView
                    android:id="@+id/tv_cycle_home_title"
                    style="@style/Antara.Text.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_group"
                    android:text="Find your softer rhythm" />

                <TextView
                    android:id="@+id/tv_cycle_home_tip"
                    style="@style/Antara.Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:text="Make room for rest with calming sounds, and support that moves with your cycle." />

                <LinearLayout
                    android:id="@+id/btn_open_music_home"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:background="@drawable/bg_list_row"
                    android:clickable="true"
                    android:contentDescription="Open your music app"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="@dimen/space_xs"
                    android:paddingBottom="@dimen/space_xs">

                    <View
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/motif_ring_filled" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_group"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito_bold"
                            android:text="Listen to calming music"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />

                        <TextView
                            style="@style/Antara.Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Opens your music app" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_right" />
                </LinearLayout>
            </LinearLayout>

            <!-- A small insight -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_section"
                android:orientation="vertical">

                <TextView
                    style="@style/Antara.Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="A small insight" />

                <TextView
                    android:id="@+id/tv_fact_title"
                    style="@style/Antara.Text.Subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_group"
                    android:text="Rest is part of moving forward." />

                <TextView
                    android:id="@+id/tv_fact_text"
                    style="@style/Antara.Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:text="Giving yourself permission to pause can ease the weight a little and make space for what comes next." />
            </LinearLayout>

            <!-- You're not alone -->
            <LinearLayout
                style="@style/Antara.Card"
                android:layout_marginTop="@dimen/space_section">

                <TextView
                    style="@style/Antara.Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="You're not alone" />

                <TextView
                    android:id="@+id/tv_testimonial_quote"
                    style="@style/Antara.Text.BodyStrong"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_group"
                    android:textSize="16sp"
                    android:text="&#8220;When things feel like a tidal wave, taking it one breath at a time can help.&#8221;" />

                <TextView
                    android:id="@+id/tv_testimonial_author"
                    style="@style/Antara.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_group"
                    android:text="Something many students feel" />
            </LinearLayout>

            <!-- A note from the makers (shown after a few check-ins) -->
            <LinearLayout
                android:id="@+id/card_supporter_preview"
                style="@style/Antara.Card"
                android:layout_marginTop="@dimen/space_section"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    style="@style/Antara.Text.Subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Help shape Antara" />

                <TextView
                    style="@style/Antara.Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="Antara is a student project and free to use. If something feels helpful, or not quite right, we'd love to hear it." />

                <Button
                    android:id="@+id/btn_supporter_learn"
                    style="@style/Antara.Button.Pill.Soft"
                    android:layout_marginTop="@dimen/space_m"
                    android:text="Share feedback" />
            </LinearLayout>

            <!-- Footer -->
            <TextView
                style="@style/Antara.Text.Small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:fontFamily="@font/nunito_bold"
                android:gravity="center"
                android:text="Your space. Your thoughts."
                android:textColor="@color/text_primary" />

            <TextView
                style="@style/Antara.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:gravity="center"
                android:text="Your reflections are saved on this device." />

        </LinearLayout>
    </ScrollView>

</RelativeLayout>
