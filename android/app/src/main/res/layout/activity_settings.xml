<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Antara.Screen.Scroll"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_settings_back"
                style="@style/Antara.IconButton"
                android:contentDescription="@string/cd_back"
                android:src="@drawable/ic_arrow_back" />
        </LinearLayout>

        <!-- Screen heading -->
        <TextView
            style="@style/Antara.Text.Display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_section"
            android:text="Settings" />

        <TextView
            style="@style/Antara.Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="Manage your profile, appearance, and support options." />

        <!-- Profile -->
        <TextView
            style="@style/Antara.Text.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_section"
            android:text="Profile" />

        <LinearLayout
            style="@style/Antara.Card"
            android:layout_marginTop="@dimen/space_group">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_settings_avatar"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_circle_soft"
                    android:fontFamily="@font/nunito_extrabold"
                    android:gravity="center"
                    android:text="A"
                    android:textColor="@color/primary_dark"
                    android:textSize="20sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_m"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_settings_name"
                        style="@style/Antara.Text.Subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Antara user" />

                    <TextView
                        android:id="@+id/tv_settings_email"
                        style="@style/Antara.Text.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="user@example.com" />

                    <TextView
                        android:id="@+id/tv_settings_phone"
                        style="@style/Antara.Text.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="No phone added" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btn_edit_profile"
                style="@style/Antara.Button.Secondary"
                android:layout_marginTop="@dimen/space_m"
                android:text="Edit personal details" />
        </LinearLayout>

        <!-- Appearance -->
        <TextView
            style="@style/Antara.Text.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_section"
            android:text="Appearance" />

        <LinearLayout
            android:id="@+id/card_settings_theme"
            style="@style/Antara.Card"
            android:layout_marginTop="@dimen/space_group">

            <LinearLayout
                android:id="@+id/row_settings_theme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_list_row"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_group"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Antara.Text.Subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="App theme" />

                    <TextView
                        android:id="@+id/tv_current_theme"
                        style="@style/Antara.Text.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Match system"
                        android:textColor="@color/primary" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_change_theme"
                    style="@style/Antara.Button.Pill"
                    android:text="Change" />
            </LinearLayout>
        </LinearLayout>

        <!-- Cycle -->
        <TextView
            style="@style/Antara.Text.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_section"
            android:text="Cycle" />

        <LinearLayout
            android:id="@+id/card_settings_cycle"
            style="@style/Antara.Card"
            android:layout_marginTop="@dimen/space_group">

            <LinearLayout
                android:id="@+id/row_settings_cycle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_list_row"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_group"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Antara.Text.Subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Current cycle phase" />

                    <TextView
                        android:id="@+id/tv_current_cycle"
                        style="@style/Antara.Text.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Not tracking"
                        android:textColor="@color/primary" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_change_cycle"
                    style="@style/Antara.Button.Pill"
                    android:text="Select" />
            </LinearLayout>

            <TextView
                style="@style/Antara.Text.Small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_group"
                android:text="Optional. Used to tailor reflection prompts and calming suggestions during different phases." />
        </LinearLayout>

        <!-- Support contact -->
        <TextView
            style="@style/Antara.Text.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_section"
            android:text="Support contact" />

        <LinearLayout
            style="@style/Antara.Card"
            android:layout_marginTop="@dimen/space_group">

            <TextView
                android:id="@+id/tv_contact_name"
                style="@style/Antara.Text.BodyStrong"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Name: Not added yet" />

            <TextView
                android:id="@+id/tv_contact_phone"
                style="@style/Antara.Text.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="Phone: Not added" />

            <TextView
                android:id="@+id/tv_contact_email"
                style="@style/Antara.Text.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="Email: Not added" />

            <Button
                android:id="@+id/btn_edit_contact"
                style="@style/Antara.Button.Secondary"
                android:layout_marginTop="@dimen/space_m"
                android:text="Edit support contact" />
        </LinearLayout>

        <!-- External helplines -->
        <LinearLayout
            style="@style/Antara.Panel.Sage"
            android:layout_marginTop="@dimen/space_group">

            <TextView
                style="@style/Antara.Text.Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="24/7 helplines" />

            <TextView
                style="@style/Antara.Text.Small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="• Tele-MANAS (Govt. of India): 14416 or 1800-891-4416\n• KIRAN Mental Health Helpline: 1800-599-0019\n• Vandrevala Foundation: +91 9999 666 555"
                android:textColor="@color/text_primary" />

            <TextView
                style="@style/Antara.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="External services. Antara is not a substitute for professional care." />
        </LinearLayout>

        <!-- Local verification -->
        <TextView
            style="@style/Antara.Text.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_section"
            android:text="Local verification" />

        <LinearLayout
            style="@style/Antara.Card"
            android:layout_marginTop="@dimen/space_group">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Antara.Text.BodyStrong"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Email address" />

                <TextView
                    android:id="@+id/btn_verify_email"
                    style="@style/Antara.Text.Accent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/space_s"
                    android:paddingTop="@dimen/space_xs"
                    android:paddingBottom="@dimen/space_xs"
                    android:text="Verify"
                    android:textColor="@color/warning" />
            </LinearLayout>

            <View
                style="@style/Antara.Divider"
                android:layout_marginTop="@dimen/space_group"
                android:layout_marginBottom="@dimen/space_group" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Antara.Text.BodyStrong"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Phone number" />

                <TextView
                    android:id="@+id/btn_verify_phone"
                    style="@style/Antara.Text.Accent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/space_s"
                    android:paddingTop="@dimen/space_xs"
                    android:paddingBottom="@dimen/space_xs"
                    android:text="Verify"
                    android:textColor="@color/warning" />
            </LinearLayout>

            <View
                style="@style/Antara.Divider"
                android:layout_marginTop="@dimen/space_group"
                android:layout_marginBottom="@dimen/space_group" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Antara.Text.BodyStrong"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Support contact" />

                <TextView
                    android:id="@+id/btn_verify_contact"
                    style="@style/Antara.Text.Accent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/space_s"
                    android:paddingTop="@dimen/space_xs"
                    android:paddingBottom="@dimen/space_xs"
                    android:text="Verify"
                    android:textColor="@color/warning" />
            </LinearLayout>

            <TextView
                style="@style/Antara.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_group"
                android:text="Demo check on this device. No email or SMS is sent." />
        </LinearLayout>

        <!-- About -->
        <TextView
            style="@style/Antara.Text.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_section"
            android:text="About" />

        <LinearLayout
            style="@style/Antara.Card"
            android:layout_marginTop="@dimen/space_group">

            <LinearLayout
                android:id="@+id/row_settings_feedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_list_row"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="@dimen/space_xs"
                android:paddingBottom="@dimen/space_xs">

                <TextView
                    style="@style/Antara.Text.Subtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Share feedback" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <View
                style="@style/Antara.Divider"
                android:layout_marginTop="@dimen/space_group"
                android:layout_marginBottom="@dimen/space_group" />

            <LinearLayout
                android:id="@+id/row_settings_about"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_list_row"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="@dimen/space_xs"
                android:paddingBottom="@dimen/space_xs">

                <TextView
                    style="@style/Antara.Text.Subtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="About Antara" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>
        </LinearLayout>

        <!-- Sign out -->
        <Button
            android:id="@+id/btn_settings_logout"
            style="@style/Antara.Button.Secondary"
            android:layout_marginTop="@dimen/space_section"
            android:text="Sign out"
            android:textColor="@color/sos_text"
            app:strokeColor="@color/crisis_stroke" />

        <!-- App Version Footer (Tap 5 times for Evaluator Dashboard) -->
        <TextView
            android:id="@+id/tv_settings_version"
            style="@style/Antara.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:gravity="center"
            android:padding="@dimen/space_s"
            android:text="Antara • Version 1.0.0\nSaved on this device in a local database. Not a substitute for professional care." />

    </LinearLayout>

</ScrollView>
