<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Antara.Screen.Scroll"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_feedback_back"
                style="@style/Antara.IconButton"
                android:contentDescription="@string/cd_back"
                android:src="@drawable/ic_arrow_back" />

            <TextView
                style="@style/Antara.Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_group"
                android:text="Feedback" />

        </LinearLayout>

        <TextView
            style="@style/Antara.Text.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_section"
            android:text="Share your thoughts" />

        <TextView
            style="@style/Antara.Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:text="Note what feels supportive and what could be calmer or clearer. Feedback is saved locally on this device." />

        <!-- Category and rating card -->
        <LinearLayout
            style="@style/Antara.Card"
            android:layout_marginTop="@dimen/space_section">

            <TextView
                style="@style/Antara.Text.FieldLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:labelFor="@id/spn_feedback_category"
                android:text="Topic" />

            <Spinner
                android:id="@+id/spn_feedback_category"
                style="@style/Antara.Spinner"
                android:layout_marginTop="@dimen/space_s" />

            <View
                style="@style/Antara.Divider"
                android:layout_marginTop="@dimen/space_m"
                android:layout_marginBottom="@dimen/space_m" />

            <TextView
                style="@style/Antara.Text.FieldLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="How has your experience been?" />

            <RatingBar
                android:id="@+id/rb_feedback_rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_group"
                android:numStars="5"
                android:progressBackgroundTint="@color/border_strong"
                android:progressTint="@color/primary"
                android:rating="5"
                android:secondaryProgressTint="@color/primary_light"
                android:stepSize="1" />

            <TextView
                android:id="@+id/tv_rating_description"
                style="@style/Antara.Text.Accent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_s"
                android:text="5 of 5 • Very supportive" />

        </LinearLayout>

        <!-- Written note card -->
        <LinearLayout
            style="@style/Antara.Card"
            android:layout_marginTop="@dimen/space_section">

            <TextView
                style="@style/Antara.Text.FieldLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:labelFor="@id/et_feedback_content"
                android:text="Your note" />

            <EditText
                android:id="@+id/et_feedback_content"
                style="@style/Antara.Input"
                android:layout_height="140dp"
                android:layout_marginTop="@dimen/space_s"
                android:gravity="top|start"
                android:hint="What felt helpful, or what would you change?"
                android:inputType="textMultiLine|textCapSentences"
                android:lineSpacingExtra="3dp" />

        </LinearLayout>

        <Button
            android:id="@+id/btn_feedback_submit"
            style="@style/Antara.Button.Primary"
            android:layout_marginTop="@dimen/space_section"
            android:text="Save feedback" />

        <TextView
            style="@style/Antara.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_group"
            android:gravity="center"
            android:text="Saved in this device's local database. Nothing is uploaded." />

    </LinearLayout>

</ScrollView>
