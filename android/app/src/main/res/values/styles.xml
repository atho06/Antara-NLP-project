<?xml version="1.0" encoding="utf-8"?>
<!--
    Antara design system styles.
    Use these on every screen so typography, color, spacing, controls and
    corner treatments stay consistent.
-->
<resources>

    <!-- ===================== Typography (Nunito) ===================== -->

    <!-- Screen heading, e.g. "Hi, Arjun." -->
    <style name="Antara.Text.Display" parent="">
        <item name="android:fontFamily">@font/nunito_extrabold</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <!-- Card / section heading, e.g. "A moment just for you" -->
    <style name="Antara.Text.Title" parent="">
        <item name="android:fontFamily">@font/nunito_bold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <!-- Smaller heading, e.g. "One day at a time" -->
    <style name="Antara.Text.Subtitle" parent="">
        <item name="android:fontFamily">@font/nunito_bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Comfortable supporting text -->
    <style name="Antara.Text.Body" parent="">
        <item name="android:fontFamily">@font/nunito_regular</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>

    <!-- Body text in the primary ink -->
    <style name="Antara.Text.BodyStrong" parent="Antara.Text.Body">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Antara.Text.Small" parent="">
        <item name="android:fontFamily">@font/nunito_regular</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="Antara.Text.Caption" parent="">
        <item name="android:fontFamily">@font/nunito_regular</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <!-- Small uppercase label. Use sparingly: one per section at most. -->
    <style name="Antara.Text.Label" parent="">
        <item name="android:fontFamily">@font/nunito_extrabold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/label</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
    </style>

    <!-- Form field label, e.g. "Session time" -->
    <style name="Antara.Text.FieldLabel" parent="">
        <item name="android:fontFamily">@font/nunito_semibold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Quiet inline action, e.g. "Sprout level" -->
    <style name="Antara.Text.Accent" parent="">
        <item name="android:fontFamily">@font/nunito_bold</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/primary</item>
    </style>

    <!-- ===================== Surfaces ===================== -->

    <!-- White card: large radius, subtle border, no shadow -->
    <style name="Antara.Card" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">@dimen/card_padding</item>
        <item name="android:orientation">vertical</item>
    </style>

    <!-- Soft sage panel -->
    <style name="Antara.Panel.Sage" parent="Antara.Card">
        <item name="android:background">@drawable/bg_panel_sage</item>
    </style>

    <!-- Warm oat panel -->
    <style name="Antara.Panel.Warm" parent="Antara.Card">
        <item name="android:background">@drawable/bg_panel_warm</item>
    </style>

    <!-- Screen scroll container with consistent side margins -->
    <style name="Antara.Screen.Scroll" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:clipToPadding">false</item>
        <item name="android:fillViewport">true</item>
        <item name="android:paddingStart">@dimen/screen_margin</item>
        <item name="android:paddingEnd">@dimen/screen_margin</item>
        <item name="android:paddingTop">@dimen/space_section</item>
        <item name="android:paddingBottom">@dimen/space_xl</item>
        <item name="android:scrollbars">none</item>
    </style>

    <!-- Hairline divider -->
    <style name="Antara.Divider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/border</item>
    </style>

    <!-- ===================== Controls ===================== -->

    <!-- Primary action: muted green, smaller corners -->
    <style name="Antara.Button.Primary" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/control_height</item>
        <item name="android:minHeight">@dimen/control_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:fontFamily">@font/nunito_bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="rippleColor">@color/ripple</item>
        <item name="cornerRadius">@dimen/radius_input</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- Secondary action: pill, outlined -->
    <style name="Antara.Button.Pill" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/pill_height</item>
        <item name="android:minHeight">@dimen/pill_height</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:fontFamily">@font/nunito_bold</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="backgroundTint">@color/surface</item>
        <item name="strokeColor">@color/border</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">@color/ripple</item>
        <item name="cornerRadius">@dimen/radius_pill</item>
    </style>

    <!-- Soft sage pill for a gentle secondary action -->
    <style name="Antara.Button.Pill.Soft">
        <item name="backgroundTint">@color/primary_soft</item>
        <item name="strokeColor">@color/primary_soft</item>
        <item name="android:textColor">@color/primary_dark</item>
    </style>

    <!-- Support / SOS pill: restrained warm tone, never alarming -->
    <style name="Antara.Button.Pill.Support">
        <item name="backgroundTint">@color/sos_soft</item>
        <item name="strokeColor">@color/sos_soft</item>
        <item name="android:textColor">@color/sos_text</item>
    </style>

    <!-- Full-width outlined secondary action -->
    <style name="Antara.Button.Secondary" parent="Antara.Button.Pill">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/control_height</item>
        <item name="android:minHeight">@dimen/control_height</item>
        <item name="android:textSize">15sp</item>
        <item name="cornerRadius">@dimen/radius_input</item>
        <item name="strokeColor">@color/border_strong</item>
    </style>

    <!-- Text-only action -->
    <style name="Antara.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:fontFamily">@font/nunito_bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/primary</item>
        <item name="rippleColor">@color/ripple</item>
    </style>

    <!-- Day-of-week circle on Home -->
    <style name="Antara.DayCircle" parent="">
        <item name="android:layout_width">38dp</item>
        <item name="android:layout_height">38dp</item>
        <item name="android:background">@drawable/bg_day_circle</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">@font/nunito_bold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Selectable option chip (quick replies, filters) -->
    <style name="Antara.Chip" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/pill_height</item>
        <item name="android:background">@drawable/bg_option_button</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">@font/nunito_semibold</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <!-- Text input -->
    <style name="Antara.Input" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/control_height</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:fontFamily">@font/nunito_regular</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_muted</item>
    </style>

    <!-- Dropdown -->
    <style name="Antara.Spinner" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/control_height</item>
        <item name="android:background">@drawable/bg_spinner</item>
        <item name="android:popupBackground">@drawable/bg_popup</item>
        <item name="android:dropDownVerticalOffset">4dp</item>
    </style>

    <!-- Circular icon button, e.g. back -->
    <style name="Antara.IconButton" parent="">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/bg_icon_button</item>
        <item name="android:scaleType">center</item>
        <item name="android:padding">10dp</item>
        <item name="tint">@color/text_primary</item>
    </style>

    <!-- Switch -->
    <style name="Antara.Switch" parent="Widget.MaterialComponents.CompoundButton.Switch">
        <item name="thumbTint">@color/switch_thumb</item>
        <item name="trackTint">@color/switch_track</item>
        <item name="useMaterialThemeColors">false</item>
    </style>

    <!-- Thin progress line -->
    <style name="Antara.Progress" parent="Widget.AppCompat.ProgressBar.Horizontal">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">4dp</item>
        <item name="android:progressDrawable">@drawable/progress_soft</item>
        <item name="android:indeterminate">false</item>
    </style>

    <!-- ===================== Dialogs ===================== -->

    <style name="ThemeOverlay.Antara.Dialog" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorAccent">@color/primary</item>
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:fontFamily">@font/nunito</item>
        <item name="fontFamily">@font/nunito</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="buttonBarPositiveButtonStyle">@style/Antara.Button.Text</item>
        <item name="buttonBarNegativeButtonStyle">@style/Antara.Button.Text.Muted</item>
        <item name="buttonBarNeutralButtonStyle">@style/Antara.Button.Text.Muted</item>
    </style>

    <style name="ThemeOverlay.Antara.MaterialDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:fontFamily">@font/nunito</item>
        <item name="fontFamily">@font/nunito</item>
        <item name="shapeAppearanceOverlay">@style/Antara.Shape.Dialog</item>
        <item name="buttonBarPositiveButtonStyle">@style/Antara.Button.Text</item>
        <item name="buttonBarNegativeButtonStyle">@style/Antara.Button.Text.Muted</item>
        <item name="buttonBarNeutralButtonStyle">@style/Antara.Button.Text.Muted</item>
    </style>

    <style name="Antara.Button.Text.Muted">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Antara.Shape.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_card</item>
    </style>

</resources>
